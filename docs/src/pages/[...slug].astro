---
import {
  getBreadcrumbs,
  getDocsPageProps,
  getDocsStaticPaths,
  getEditUrl,
  getPrevNext,
  getRouteFlags,
  getSidebar,
  getTOC,
} from "@cloudflare/nimbus-docs";
import type { GetStaticPaths } from "astro";
import { components } from "../components";
import DocsLayout from "../layouts/DocsLayout.astro";

export const prerender = true;
export const getStaticPaths: GetStaticPaths = async (context) =>
  (await getDocsStaticPaths(context)).map((path) =>
    path.params.slug === "index" ? { ...path, params: { slug: undefined } } : path,
  );

const { entry, Content, headings } = await getDocsPageProps(Astro);
const slug = Astro.url.pathname.replace(/\/$/, "") || "/";
const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);
const sidebar = sidebarOn ? await getSidebar(slug, { collection: entry.collection }) : false;
const prevNext = await getPrevNext(slug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const toc = tocOn && entry.data.tableOfContents !== false ? getTOC(headings, entry.data.tableOfContents) : false;
const breadcrumbs = await getBreadcrumbs(slug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  lastUpdated={entry.data.lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
