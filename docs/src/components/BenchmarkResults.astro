---
import results from "../../../benchmarks/src/results.json";

const timestamp = new Date(results.timestamp).toLocaleString("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});
const format = (value: number, unit: string) =>
  unit === "bytes" ? `${(value / 1_000_000).toFixed(2)} MB` : `${value.toFixed(1)} ms`;
const metricLabel = (unit: string) => (unit === "bytes" ? "Heap used" : "Time");
const hostMemory = `${(results.environment.hostMemoryBytes / 1024 ** 3).toFixed(1)} GiB`;
const cpuSamples = "cpuSamples" in results.environment ? results.environment.cpuSamples : 1;
const sourceRevision = results.gitDirty
  ? `a dirty working tree based on ${results.gitHash.slice(0, 8)}`
  : `commit ${results.gitHash.slice(0, 8)}`;
const comparison = (value: number, best: number, unit: string, index: number) => {
  if (index === 0) return "Reference";

  const difference = (((value - best) / best) * 100).toFixed(1);
  return unit === "bytes" ? `+${difference}% more heap` : `+${difference}% slower`;
};
---

<aside class="benchmark-provenance">
  <strong>How to read this snapshot</strong>
  <p>
    Recorded {timestamp} UTC from {sourceRevision} with {results.environment.chromium}, {results.environment.node} on {results.environment.platform}, {results.environment.processor} ({results.environment.logicalCores} logical cores, {results.environment.architecture}), and {hostMemory} host memory. CPU operations use {results.environment.warmups} warmups and {cpuSamples} measured samples; each memory row is a single validated reading from its own fresh page.
  </p>
</aside>

{results.operations.map((operation) => {
  const best = operation.results[0]?.value ?? 0;
  return (
    <section>
      <h2>{operation.name}</h2>
      <p>{operation.unit === "bytes" ? "Lower heap use is better." : "Lower time is better."}</p>
      <table>
        <thead><tr><th>Framework</th><th>{metricLabel(operation.unit)}</th><th>Compared with reference</th></tr></thead>
        <tbody>
          {operation.results.map((result, index) => (
            <tr>
              <td><strong>{result.framework}</strong></td>
              <td>
                {format(result.value, operation.unit)}
                {operation.unit === "ms" && "confidenceLow" in result && "confidenceHigh" in result
                  ? ` (${result.confidenceLow.toFixed(1)}-${result.confidenceHigh.toFixed(1)} 95% CI)`
                  : null}
              </td>
              <td>{comparison(result.value, best, operation.unit, index)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  );
})}
