{
  "name": "taipa-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "check": "vp check",
    "check:django": "uv --directory integrations/django run --frozen ruff check && uv --directory integrations/django run --frozen ruff format --check",
    "test:django": "uv --directory integrations/django run --frozen pytest",
    "smoke:toolchain": "node scripts/smoke-toolchain.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:cdn": "node scripts/verify-esm-sh.mjs",
    "prepare": "vp config",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
