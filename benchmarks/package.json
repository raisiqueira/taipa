    "react-dom": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "^4.3.3",
    "tinybench": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-cli": "catalog:",
    "vite-plus": "catalog:"
  }
}
