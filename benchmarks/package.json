{
  "name": "@taipa/benchmarks",
  "version": "1.0.0",
  "private": true,
  "description": "Local js-framework-benchmark-style comparisons for Taipa UI.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "bench": "node scripts/run-benchmarks.mjs",
    "bench:repeat": "node bench/run-repeat-browser.mjs",
    "bench:ui": "node bench/index.mjs",
    "preview": "vite preview",
    "bench:serialization": "node bench/run-serialization-browser.mjs",
    "bench:client-lifecycle": "node bench/run-client-lifecycle-browser.mjs"
  },
  "dependencies": {
    "@taipa/ui": "workspace:*",
    "alien-signals": "catalog:",
    "ilha": "catalog:",
    "lit-html": "catalog:",
